{
  "name": "@forge/cli",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "forge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/index.ts",
    "forge": "node src/index.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@forge/compiler": "workspace:*",
    "@forge/generators": "workspace:*",
    "@forge/language": "workspace:*",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
